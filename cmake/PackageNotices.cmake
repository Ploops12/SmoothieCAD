# Generate the notices shipped next to the embedded addon runtime. This script
# copies actual upstream/distribution files; it does not substitute license IDs
# or a guessed license for missing redistribution material.
cmake_minimum_required(VERSION 3.25)

foreach(_required IN ITEMS SOURCE_DIR BINARY_DIR OUTPUT_DIR OCCT_SOURCE_DIR EIGEN_SOURCE_DIR BOOST_SOURCE_DIR PYBIND11_SOURCE_DIR RUNTIME_MANIFEST)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "PackageNotices requires -D${_required}=...")
    endif()
endforeach()
if(NOT EXISTS "${BINARY_DIR}/.blendercad-build")
    message(FATAL_ERROR "PackageNotices requires a configured BlenderCAD build directory")
endif()
file(REAL_PATH "${BINARY_DIR}" BINARY_DIR)
cmake_path(ABSOLUTE_PATH OUTPUT_DIR BASE_DIRECTORY "${BINARY_DIR}" NORMALIZE)
cmake_path(IS_PREFIX BINARY_DIR "${OUTPUT_DIR}" NORMALIZE _inside_build)
if(NOT _inside_build OR OUTPUT_DIR STREQUAL BINARY_DIR)
    message(FATAL_ERROR "Notices must be staged in a child of the configured build directory")
endif()
if(NOT DEFINED LICENSE_ROOT)
    set(LICENSE_ROOT "/usr/share/licenses")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set_property(GLOBAL PROPERTY _blendercad_notice_index "{\"schema_version\":1,\"files\":[],\"libraries\":[]}")
set_property(GLOBAL PROPERTY _blendercad_notice_file_count 0)

function(_notice_quote output value)
    string(REPLACE "\\" "\\\\" _value "${value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    set(${output} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(_record_notice component path)
    file(SHA256 "${OUTPUT_DIR}/${path}" _sha)
    _notice_quote(_component "${component}")
    _notice_quote(_path "${path}")
    _notice_quote(_hash "${_sha}")
    string(JSON _entry SET "{}" component "${_component}")
    string(JSON _entry SET "${_entry}" path "${_path}")
    string(JSON _entry SET "${_entry}" sha256 "${_hash}")
    get_property(_index GLOBAL PROPERTY _blendercad_notice_index)
    get_property(_count GLOBAL PROPERTY _blendercad_notice_file_count)
    string(JSON _index SET "${_index}" files ${_count} "${_entry}")
    math(EXPR _count "${_count} + 1")
    set_property(GLOBAL PROPERTY _blendercad_notice_index "${_index}")
    set_property(GLOBAL PROPERTY _blendercad_notice_file_count "${_count}")
endfunction()

function(_copy_notice component source destination)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}")
        message(FATAL_ERROR "Actual ${component} notice is absent: ${source}. Populate the pinned dependency sources through CMake before packaging.")
    endif()
    get_filename_component(_parent "${OUTPUT_DIR}/${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(COPY_FILE "${source}" "${OUTPUT_DIR}/${destination}" ONLY_IF_DIFFERENT)
    _record_notice("${component}" "${destination}")
endfunction()

_copy_notice("OCCT" "${OCCT_SOURCE_DIR}/LICENSE_LGPL_21.txt" "OCCT/LICENSE_LGPL_21.txt")
_copy_notice("OCCT" "${OCCT_SOURCE_DIR}/OCCT_LGPL_EXCEPTION.txt" "OCCT/OCCT_LGPL_EXCEPTION.txt")
_copy_notice("PlaneGCS" "${SOURCE_DIR}/third_party/planegcs/upstream/LICENSE" "PlaneGCS/FreeCAD-LICENSE")
_copy_notice("PlaneGCS" "${OCCT_SOURCE_DIR}/LICENSE_LGPL_21.txt" "PlaneGCS/LICENSE_LGPL_21.txt")
_copy_notice("PlaneGCS" "${SOURCE_DIR}/third_party/planegcs/manifest.json" "PlaneGCS/source-manifest.json")
file(READ "${SOURCE_DIR}/third_party/planegcs/manifest.json" _gcs_manifest)
string(JSON _gcs_revision GET "${_gcs_manifest}" revision)
set(_preambles "PlaneGCS source copyright/license headers\nFreeCAD revision ${_gcs_revision}\n\n")
file(GLOB _gcs_files "${SOURCE_DIR}/third_party/planegcs/upstream/src/Mod/Sketcher/App/planegcs/*")
list(SORT _gcs_files)
foreach(_file IN LISTS _gcs_files)
    get_filename_component(_name "${_file}" NAME)
    string(APPEND _preambles "--- ${_name} ---\n")
    file(STRINGS "${_file}" _header LIMIT_COUNT 100)
    foreach(_line IN LISTS _header)
        if(_line MATCHES "^[ \t]*#")
            break()
        endif()
        string(APPEND _preambles "${_line}\n")
    endforeach()
    string(APPEND _preambles "\n")
endforeach()
file(WRITE "${OUTPUT_DIR}/PlaneGCS/COPYRIGHT-HEADERS.txt" "${_preambles}")
_record_notice("PlaneGCS" "PlaneGCS/COPYRIGHT-HEADERS.txt")
file(WRITE "${OUTPUT_DIR}/PlaneGCS/LOCAL-COMPATIBILITY.txt"
    "PlaneGCS is statically linked into BlenderCAD's native module.\n"
    "The recorded upstream solver files are retained unchanged and verified by SHA-256 during CMake configuration.\n"
    "The source companion includes all of these files plus locally supplied SketcherGlobal.h, Base/Console.h, Base/Tools.h, FCConfig.h and boost_graph_adjacency_list.hpp compatibility headers.\n"
    "These shims replace FreeCAD export macros, console/timing/configuration surfaces and a Boost forwarding include; solver algorithms are not patched.\n"
    "See the companion's BUILDING-AND-RELINKING.md for rebuilding the native module with modified solver sources.\n")
_record_notice("PlaneGCS" "PlaneGCS/LOCAL-COMPATIBILITY.txt")
file(GLOB _eigen_notices "${EIGEN_SOURCE_DIR}/COPYING*")
if(NOT _eigen_notices)
    message(FATAL_ERROR "Eigen COPYING files are absent from ${EIGEN_SOURCE_DIR}")
endif()
list(SORT _eigen_notices)
foreach(_file IN LISTS _eigen_notices)
    get_filename_component(_name "${_file}" NAME)
    _copy_notice("Eigen" "${_file}" "Eigen/${_name}")
endforeach()
_copy_notice("Boost" "${BOOST_SOURCE_DIR}/LICENSE_1_0.txt" "Boost/LICENSE_1_0.txt")
_copy_notice("pybind11" "${PYBIND11_SOURCE_DIR}/LICENSE" "pybind11/LICENSE")
_copy_notice("build-provenance" "${SOURCE_DIR}/cmake/Dependencies.cmake" "dependency-build-definitions.cmake")

if(NOT EXISTS "${RUNTIME_MANIFEST}")
    message(FATAL_ERROR "Runtime manifest is absent: ${RUNTIME_MANIFEST}. Stage the runtime before generating notices.")
endif()
file(READ "${RUNTIME_MANIFEST}" _runtime)
string(JSON _library_count ERROR_VARIABLE _manifest_error LENGTH "${_runtime}" libraries)
if(_manifest_error)
    message(FATAL_ERROR "Runtime manifest must contain a libraries array: ${_manifest_error}")
endif()
set(_copied_components)
if(_library_count GREATER 0)
    math(EXPR _last_library "${_library_count} - 1")
    foreach(_index RANGE 0 ${_last_library})
        string(JSON _soname ERROR_VARIABLE _soname_error GET "${_runtime}" libraries ${_index} soname)
        if(_soname_error OR _soname MATCHES "[/\\]" OR _soname MATCHES "^\\.\\.?$")
            message(FATAL_ERROR "Invalid or missing SONAME in runtime manifest library ${_index}")
        endif()
        set(_component "")
        set(_license "")
        if(_soname MATCHES "^libTK[A-Za-z0-9_]+\\.so")
            set(_component "OCCT")
        elseif(_soname MATCHES "^libX11\\.so")
            set(_component "libx11")
            set(_license "COPYING")
        elseif(_soname MATCHES "^libxcb\\.so")
            set(_component "libxcb")
            set(_license "COPYING")
        elseif(_soname MATCHES "^libfontconfig\\.so")
            set(_component "fontconfig")
            set(_license "COPYING")
        elseif(_soname MATCHES "^libfreetype\\.so")
            set(_component "freetype2")
            set(_license "FTL.TXT")
        elseif(_soname MATCHES "^libexpat\\.so")
            set(_component "expat")
            set(_license "COPYING")
        elseif(_soname MATCHES "^libz\\.so")
            set(_component "zlib")
            set(_license "LICENSE")
        elseif(_soname MATCHES "^libbz2\\.so")
            set(_component "bzip2")
            set(_license "LICENSE")
        elseif(_soname MATCHES "^libpng[0-9]*\\.so")
            set(_component "libpng")
            set(_license "LICENSE")
        elseif(_soname MATCHES "^libbrotli(dec|common|enc)\\.so")
            set(_component "brotli")
            set(_license "LICENSE")
        elseif(_soname MATCHES "^libXau\\.so")
            set(_component "libxau")
            set(_license "COPYING")
        elseif(_soname MATCHES "^libXdmcp\\.so")
            set(_component "libxdmcp")
            set(_license "COPYING")
        endif()
        if(DEFINED NOTICES_OVERRIDE_DIR AND IS_DIRECTORY "${NOTICES_OVERRIDE_DIR}/${_soname}")
            set(_component "override-${_soname}")
            if(NOT _component IN_LIST _copied_components)
                file(GLOB_RECURSE _overrides LIST_DIRECTORIES FALSE RELATIVE "${NOTICES_OVERRIDE_DIR}/${_soname}" "${NOTICES_OVERRIDE_DIR}/${_soname}/*")
                if(NOT _overrides)
                    message(FATAL_ERROR "Notice override directory is empty for ${_soname}")
                endif()
                list(SORT _overrides)
                foreach(_file IN LISTS _overrides)
                    _copy_notice("${_component}" "${NOTICES_OVERRIDE_DIR}/${_soname}/${_file}" "runtime/${_component}/${_file}")
                endforeach()
                list(APPEND _copied_components "${_component}")
            endif()
        elseif(_component STREQUAL "")
            message(FATAL_ERROR "Bundled library ${_soname} has no notice mapping. Supply actual redistribution materials under -DNOTICES_OVERRIDE_DIR=<root>/${_soname}/ (pass <root>), or add an explicit reviewed mapping.")
        elseif(NOT _component STREQUAL "OCCT" AND NOT _component IN_LIST _copied_components)
            set(_notice "${LICENSE_ROOT}/${_component}/${_license}")
            if(NOT EXISTS "${_notice}")
                message(FATAL_ERROR "Bundled ${_soname} notice is missing: ${_notice}. Set -DLICENSE_ROOT=<distribution-license-root> or supply actual files in NOTICES_OVERRIDE_DIR/${_soname}/.")
            endif()
            _copy_notice("${_component}" "${_notice}" "runtime/${_component}/${_license}")
            list(APPEND _copied_components "${_component}")
        endif()
        _notice_quote(_soname_json "${_soname}")
        _notice_quote(_component_json "${_component}")
        string(JSON _entry SET "{}" soname "${_soname_json}")
        string(JSON _entry SET "${_entry}" component "${_component_json}")
        get_property(_notice_index GLOBAL PROPERTY _blendercad_notice_index)
        string(JSON _notice_index SET "${_notice_index}" libraries ${_index} "${_entry}")
        set_property(GLOBAL PROPERTY _blendercad_notice_index "${_notice_index}")
    endforeach()
endif()
file(WRITE "${OUTPUT_DIR}/NOTICE.txt"
    "BlenderCAD dependency redistribution materials\n\n"
    "The addon embeds OCCT geometry/exchange services, the PlaneGCS planar sketch solver, Eigen and Boost headers, and pybind11 bindings. The native module and copied runtime libraries are identified in the runtime manifest.\n\n"
    "Actual upstream and build-host distribution license/copyright files are retained in the subdirectories indexed by notice-index.json. The runtime uses the FreeType font engine when libfreetype is present; its copyright owners and terms are reproduced in runtime/freetype2/FTL.TXT (or the explicit SONAME override).\n\n"
    "PlaneGCS is statically linked. Its upstream source, original copyright headers, local compatibility files and complete project build/relink sources are supplied in the separately generated BlenderCAD sources companion. No download or compiler is used by an installed addon.\n\n"
    "OCCT's cached pinned upstream source is a reproducible rebuild baseline, not a claim that an installed distribution binary has no downstream patches. Refer to the runtime manifest for the actual binary paths, versions and hashes, and to SOURCE-MANIFEST.json in the source companion for source identities and scope.\n\n"
    "This collection does not assign a new license to BlenderCAD project files or replace the individual upstream license terms.\n")
_record_notice("overview" "NOTICE.txt")
get_property(_notice_index GLOBAL PROPERTY _blendercad_notice_index)
file(WRITE "${OUTPUT_DIR}/notice-index.json" "${_notice_index}\n")

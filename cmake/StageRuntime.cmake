# Stage the private Linux runtime without changing the native build artifact or
# installed libraries. Invoked by the build graph, never from the Blender addon.
cmake_minimum_required(VERSION 3.25)

if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Runtime staging currently supports Linux ELF packages only")
endif()
foreach(_argument IN ITEMS MODULE OUTPUT_DIR RESOURCE_DIR)
    if(NOT DEFINED ${_argument} OR "${${_argument}}" STREQUAL "")
        message(FATAL_ERROR "StageRuntime requires -D${_argument}=...")
    endif()
endforeach()
if(NOT EXISTS "${MODULE}" OR IS_DIRECTORY "${MODULE}")
    message(FATAL_ERROR "Native module does not exist: ${MODULE}")
endif()
if(NOT IS_DIRECTORY "${RESOURCE_DIR}")
    message(FATAL_ERROR "OCCT resource directory does not exist: ${RESOURCE_DIR}")
endif()
find_program(_readelf NAMES readelf REQUIRED)
file(REAL_PATH "${MODULE}" _module)
file(REAL_PATH "${RESOURCE_DIR}" _resource_root)
get_filename_component(_output "${OUTPUT_DIR}" ABSOLUTE)
get_filename_component(_module_dir "${_module}" DIRECTORY)
if(_output STREQUAL _module_dir)
    message(FATAL_ERROR "Runtime staging must not replace libraries beside the build module")
endif()

function(_quote _out _value)
    string(REPLACE "\\" "\\\\" _value "${_value}")
    string(REPLACE "\"" "\\\"" _value "${_value}")
    string(REPLACE "\n" "\\n" _value "${_value}")
    string(REPLACE "\r" "\\r" _value "${_value}")
    string(REPLACE "\t" "\\t" _value "${_value}")
    set(${_out} "\"${_value}\"" PARENT_SCOPE)
endfunction()

function(_array _out)
    set(_result "[]")
    set(_index 0)
    foreach(_item IN LISTS ARGN)
        _quote(_item_json "${_item}")
        string(JSON _result SET "${_result}" ${_index} "${_item_json}")
        math(EXPR _index "${_index} + 1")
    endforeach()
    set(${_out} "${_result}" PARENT_SCOPE)
endfunction()

function(_versions _out _glibc _glibcxx _cxxabi _other)
    set(_result "{}")
    foreach(_family IN ITEMS GLIBC GLIBCXX CXXABI other)
        string(TOLOWER "${_family}" _lower)
        set(_items "${_${_lower}}")
        list(REMOVE_DUPLICATES _items)
        list(SORT _items COMPARE NATURAL)
        _array(_items_json ${_items})
        string(JSON _result SET "${_result}" "${_family}" "${_items_json}")
    endforeach()
    set(${_out} "${_result}" PARENT_SCOPE)
endfunction()

function(_elf _path _prefix)
    file(REAL_PATH "${_path}" _real)
    execute_process(COMMAND "${_readelf}" --dynamic --wide "${_real}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _dynamic ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ELF runtime ${_real}: ${_error}")
    endif()
    set(_needed)
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]]+\\]" _entries "${_dynamic}")
    foreach(_entry IN LISTS _entries)
        string(REGEX REPLACE ".*\\[([^]]+)\\].*" "\\1" _name "${_entry}")
        if(_name MATCHES "[/\\\\]")
            message(FATAL_ERROR "Absolute/path-qualified DT_NEEDED cannot be relocated: ${_real}: ${_name}")
        endif()
        list(APPEND _needed "${_name}")
    endforeach()
    set(_soname "")
    if(_dynamic MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
        set(_soname "${CMAKE_MATCH_1}")
    endif()
    set(_rpath)
    set(_runpath)
    foreach(_tag IN ITEMS RPATH RUNPATH)
        if(_dynamic MATCHES "\\(${_tag}\\)[^\n]*\\[([^]]*)\\]")
            string(REPLACE ":" ";" _paths "${CMAKE_MATCH_1}")
            string(TOLOWER "${_tag}" _lower)
            set(_${_lower} "${_paths}")
        endif()
    endforeach()
    execute_process(COMMAND "${_readelf}" --file-header --wide "${_real}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _header ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ELF header ${_real}: ${_error}")
    endif()
    foreach(_field IN ITEMS Class Machine)
        if(NOT _header MATCHES "\n[ \t]*${_field}:[ \t]*([^\n\r]+)")
            message(FATAL_ERROR "Missing ELF ${_field} in ${_real}")
        endif()
        string(TOLOWER "${_field}" _lower)
        string(STRIP "${CMAKE_MATCH_1}" _${_lower})
    endforeach()
    execute_process(COMMAND "${_readelf}" --version-info --wide "${_real}"
        RESULT_VARIABLE _status OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0)
        message(FATAL_ERROR "Cannot inspect ELF symbol versions ${_real}: ${_error}")
    endif()
    # Provider definitions are not requirements. In particular, copying every
    # version exported by the host libc would invent an excessive ABI baseline.
    string(FIND "${_symbols}" "Version needs section" _needs_start)
    set(_glibc)
    set(_glibcxx)
    set(_cxxabi)
    set(_other)
    if(NOT _needs_start EQUAL -1)
        string(SUBSTRING "${_symbols}" ${_needs_start} -1 _symbols)
        string(REGEX MATCHALL "Name: [A-Za-z0-9_.]+" _names "${_symbols}")
        foreach(_entry IN LISTS _names)
            string(REPLACE "Name: " "" _name "${_entry}")
            if(_name MATCHES "^GLIBC_([0-9]+(\\.[0-9]+)+)$")
                list(APPEND _glibc "${CMAKE_MATCH_1}")
            elseif(_name MATCHES "^GLIBCXX_([0-9]+(\\.[0-9]+)+)$")
                list(APPEND _glibcxx "${CMAKE_MATCH_1}")
            elseif(_name MATCHES "^CXXABI_([0-9]+(\\.[0-9]+)+)$")
                list(APPEND _cxxabi "${CMAKE_MATCH_1}")
            else()
                list(APPEND _other "${_name}")
            endif()
        endforeach()
    endif()
    _versions(_versions_json "${_glibc}" "${_glibcxx}" "${_cxxabi}" "${_other}")
    file(SHA256 "${_real}" _sha256)
    file(SIZE "${_real}" _bytes)
    get_filename_component(_filename "${_real}" NAME)
    set(_file_version "")
    if(_filename MATCHES "\\.so\\.([0-9]+(\\.[0-9]+)*)$")
        set(_file_version "${CMAKE_MATCH_1}")
    endif()
    set(_record "{}")
    foreach(_field IN ITEMS soname sha256 file_version)
        _quote(_value "${_${_field}}")
        string(JSON _record SET "${_record}" "${_field}" "${_value}")
    endforeach()
    _quote(_value "${_real}")
    string(JSON _record SET "${_record}" source_path "${_value}")
    _quote(_value "${_filename}")
    string(JSON _record SET "${_record}" source_filename "${_value}")
    string(JSON _record SET "${_record}" bytes ${_bytes})
    foreach(_field IN ITEMS needed rpath runpath)
        _array(_value ${_${_field}})
        string(JSON _record SET "${_record}" "${_field}" "${_value}")
    endforeach()
    string(JSON _record SET "${_record}" required_versions "${_versions_json}")
    foreach(_field IN ITEMS soname needed rpath runpath class machine glibc glibcxx cxxabi other sha256)
        set(${_prefix}_${_field} "${_${_field}}" PARENT_SCOPE)
    endforeach()
    set(${_prefix}_record "${_record}" PARENT_SCOPE)
endfunction()

_elf("${_module}" _native)
if(NOT _native_rpath STREQUAL "$ORIGIN/.libs" OR _native_runpath)
    message(FATAL_ERROR "Native module must have only DT_RPATH=$ORIGIN/.libs (not RUNPATH): ${_module}")
endif()
set(_search_dirs)
if(DEFINED LIBRARY_DIR AND IS_DIRECTORY "${LIBRARY_DIR}")
    file(REAL_PATH "${LIBRARY_DIR}" _selected_library_dir)
    list(APPEND _search_dirs "${LIBRARY_DIR}")
endif()
get_filename_component(_resource_prefix "${_resource_root}/../../.." ABSOLUTE)
foreach(_candidate IN ITEMS "${_resource_prefix}/lib" "${_resource_prefix}/lib64")
    if(IS_DIRECTORY "${_candidate}")
        list(APPEND _search_dirs "${_candidate}")
    endif()
endforeach()
list(REMOVE_DUPLICATES _search_dirs)
# Resolve against the selected toolchain's OCCT directory, not a previous
# staged bundle or another installed copy with the same SONAME. The temporary
# module retains its literal origin rpath; only this disposable origin changes.
set(_discovery_module "${_module}")
if(DEFINED LIBRARY_DIR AND IS_DIRECTORY "${LIBRARY_DIR}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _suffix)
    set(_discovery_dir "${_output}/.resolve-${_suffix}")
    file(MAKE_DIRECTORY "${_discovery_dir}")
    get_filename_component(_module_name "${_module}" NAME)
    file(COPY_FILE "${_module}" "${_discovery_dir}/${_module_name}")
    file(CREATE_LINK "${LIBRARY_DIR}" "${_discovery_dir}/.libs" SYMBOLIC RESULT _link_error)
    if(NOT _link_error STREQUAL "0")
        message(FATAL_ERROR "Cannot select runtime discovery directory: ${_link_error}")
    endif()
    set(_discovery_module "${_discovery_dir}/${_module_name}")
endif()
file(GET_RUNTIME_DEPENDENCIES LIBRARIES "${_discovery_module}"
    DIRECTORIES ${_search_dirs}
    RESOLVED_DEPENDENCIES_VAR _resolved
    UNRESOLVED_DEPENDENCIES_VAR _unresolved
    CONFLICTING_DEPENDENCIES_PREFIX _conflicts)
set(_canonical_resolved)
foreach(_library IN LISTS _resolved)
    file(REAL_PATH "${_library}" _canonical)
    list(APPEND _canonical_resolved "${_canonical}")
endforeach()
set(_resolved "${_canonical_resolved}")
list(REMOVE_DUPLICATES _resolved)
if(DEFINED _discovery_dir)
    file(REMOVE_RECURSE "${_discovery_dir}")
endif()
if(_unresolved)
    message(FATAL_ERROR "Unresolved native runtime dependencies: ${_unresolved}")
endif()
if(_conflicts_FILENAMES)
    message(FATAL_ERROR "Conflicting runtime library resolutions: ${_conflicts_FILENAMES}")
endif()
list(SORT _resolved)
set(_libraries "[]")
set(_platform_libraries "[]")
set(_all_needed "${_native_needed}")
set(_sonames)
set(_copy_sources)
set(_copy_names)
foreach(_family IN ITEMS glibc glibcxx cxxabi other)
    set(_aggregate_${_family} "${_native_${_family}}")
endforeach()
foreach(_library IN LISTS _resolved)
    cmake_path(IS_PREFIX _output "${_library}" NORMALIZE _from_staging)
    if(_from_staging)
        message(FATAL_ERROR "Runtime discovery selected an old staging output: ${_library}; use the original library directory")
    endif()
    _elf("${_library}" _lib)
    if(_lib_soname MATCHES "^libTK[^/]*\\.so" AND DEFINED _selected_library_dir)
        cmake_path(IS_PREFIX _selected_library_dir "${_library}" NORMALIZE _selected_occt)
        if(NOT _selected_occt)
            message(FATAL_ERROR "OCCT toolkit resolved outside the selected library directory: ${_library}")
        endif()
    endif()
    if(NOT _lib_soname OR _lib_soname MATCHES "[/\\\\]")
        message(FATAL_ERROR "Runtime library lacks a plain SONAME: ${_library}")
    endif()
    if(_lib_soname IN_LIST _sonames)
        message(FATAL_ERROR "More than one resolved library has SONAME ${_lib_soname}")
    endif()
    if(NOT _lib_class STREQUAL _native_class OR NOT _lib_machine STREQUAL _native_machine)
        message(FATAL_ERROR "Runtime ELF architecture differs from native module: ${_library}")
    endif()
    list(APPEND _sonames "${_lib_soname}")
    list(APPEND _all_needed ${_lib_needed})
    # These are the explicit Linux process/platform baseline, not a general
    # /usr/lib exclusion. X11/fonts/compression and every OCCT library are copied.
    if(_lib_soname MATCHES "^lib(c|m|pthread|dl|rt|resolv|util)\\.so\\.[0-9]+$"
            OR _lib_soname STREQUAL "libstdc++.so.6"
            OR _lib_soname STREQUAL "libgcc_s.so.1"
            OR _lib_soname MATCHES "^ld-linux[^/]*\\.so\\.[0-9]+$")
        set(_record "${_lib_record}")
        string(JSON _record SET "${_record}" reason "\"platform_baseline\"")
        string(JSON _index LENGTH "${_platform_libraries}")
        string(JSON _platform_libraries SET "${_platform_libraries}" ${_index} "${_record}")
    else()
        foreach(_path IN LISTS _lib_rpath _lib_runpath)
            if(NOT _path STREQUAL "$ORIGIN" AND NOT _path STREQUAL "$ORIGIN/."
                    AND NOT _path STREQUAL "\${ORIGIN}" AND NOT _path STREQUAL "\${ORIGIN}/.")
                message(FATAL_ERROR "Runtime library contains an unrelocatable search path '${_path}': ${_library}")
            endif()
        endforeach()
        set(_record "${_lib_record}")
        _quote(_value ".libs/${_lib_soname}")
        string(JSON _record SET "${_record}" path "${_value}")
        string(JSON _index LENGTH "${_libraries}")
        string(JSON _libraries SET "${_libraries}" ${_index} "${_record}")
        list(APPEND _copy_sources "${_library}")
        list(APPEND _copy_names "${_lib_soname}")
        foreach(_family IN ITEMS glibc glibcxx cxxabi other)
            list(APPEND _aggregate_${_family} ${_lib_${_family}})
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES _all_needed)
foreach(_needed IN LISTS _all_needed)
    if(NOT _needed IN_LIST _sonames)
        message(FATAL_ERROR "DT_NEEDED name has no matching resolved SONAME: ${_needed}")
    endif()
endforeach()
if(NOT _copy_names)
    message(FATAL_ERROR "Native module has no private runtime dependencies to stage")
endif()
set(_resource_directories XSTEPResource XSMessage SHMessage StdResource)
set(_resource_files)
foreach(_directory IN LISTS _resource_directories)
    if(NOT IS_DIRECTORY "${_resource_root}/${_directory}")
        message(FATAL_ERROR "Required OCCT resource directory is missing: ${_resource_root}/${_directory}")
    endif()
    file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_resource_root}" "${_resource_root}/${_directory}/*")
    if(NOT _files)
        message(FATAL_ERROR "Required OCCT resource directory is empty: ${_directory}")
    endif()
    list(APPEND _resource_files ${_files})
endforeach()
list(SORT _resource_files)

# Only replace this script's three owned outputs. A marker prevents a mistaken
# output argument from erasing somebody else's existing .libs/resources tree.
foreach(_directory IN ITEMS .libs resources)
    if(IS_SYMLINK "${_output}/${_directory}")
        message(FATAL_ERROR "Refusing a symlink runtime staging directory: ${_output}/${_directory}")
    endif()
    if(EXISTS "${_output}/${_directory}")
        file(GLOB _existing "${_output}/${_directory}/*" "${_output}/${_directory}/.*")
        if(_existing AND NOT EXISTS "${_output}/${_directory}/.blendercad-runtime-stage")
            message(FATAL_ERROR "Refusing to replace an unmarked runtime staging directory: ${_output}/${_directory}")
        endif()
    endif()
endforeach()
foreach(_directory IN ITEMS .libs resources)
    file(REMOVE_RECURSE "${_output}/${_directory}")
    file(MAKE_DIRECTORY "${_output}/${_directory}")
    file(WRITE "${_output}/${_directory}/.blendercad-runtime-stage" "BlenderCAD generated runtime staging\n")
endforeach()
list(LENGTH _copy_names _copy_count)
math(EXPR _last "${_copy_count} - 1")
foreach(_index RANGE 0 ${_last})
    list(GET _copy_sources ${_index} _source)
    list(GET _copy_names ${_index} _name)
    file(COPY_FILE "${_source}" "${_output}/.libs/${_name}" ONLY_IF_DIFFERENT)
endforeach()
set(_resources "[]")
foreach(_relative IN LISTS _resource_files)
    set(_source "${_resource_root}/${_relative}")
    if(IS_SYMLINK "${_source}")
        message(FATAL_ERROR "Refusing a symlink OCCT resource: ${_source}")
    endif()
    get_filename_component(_parent "${_output}/resources/${_relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${_parent}")
    file(COPY_FILE "${_source}" "${_output}/resources/${_relative}" ONLY_IF_DIFFERENT)
    file(SHA256 "${_source}" _hash)
    set(_record "{}")
    foreach(_field IN ITEMS path sha256 source_path)
        if(_field STREQUAL "path")
            set(_value "resources/${_relative}")
        elseif(_field STREQUAL "sha256")
            set(_value "${_hash}")
        else()
            set(_value "${_source}")
        endif()
        _quote(_value_json "${_value}")
        string(JSON _record SET "${_record}" "${_field}" "${_value_json}")
    endforeach()
    string(JSON _index LENGTH "${_resources}")
    string(JSON _resources SET "${_resources}" ${_index} "${_record}")
endforeach()
_versions(_aggregate_versions "${_aggregate_glibc}" "${_aggregate_glibcxx}" "${_aggregate_cxxabi}" "${_aggregate_other}")
set(_platform "{}")
string(JSON _platform SET "${_platform}" system "\"Linux\"")
_quote(_value "${_native_class}")
string(JSON _platform SET "${_platform}" elf_class "${_value}")
_quote(_value "${_native_machine}")
string(JSON _platform SET "${_platform}" machine "${_value}")
if(_native_machine STREQUAL "Advanced Micro Devices X86-64")
    set(_architecture x86_64)
elseif(_native_machine STREQUAL "AArch64")
    set(_architecture aarch64)
else()
    set(_architecture "${_native_machine}")
endif()
_quote(_value "${_architecture}")
string(JSON _platform SET "${_platform}" architecture "${_value}")
string(JSON _platform SET "${_platform}" required_versions "${_aggregate_versions}")
get_filename_component(_native_name "${_module}" NAME)
_quote(_value "${_native_name}")
string(JSON _native_record SET "${_native_record}" filename "${_value}")
set(_manifest "{\"format_version\":1}")
foreach(_field IN ITEMS module libraries platform_libraries resources platform)
    if(_field STREQUAL "module")
        set(_value "${_native_record}")
    else()
        set(_value "${_${_field}}")
    endif()
    string(JSON _manifest SET "${_manifest}" "${_field}" "${_value}")
endforeach()
_array(_value ${_resource_directories})
string(JSON _manifest SET "${_manifest}" resource_directories "${_value}")
_quote(_value "${_resource_root}")
string(JSON _manifest SET "${_manifest}" source_resource_dir "${_value}")
file(WRITE "${_output}/runtime-manifest.json" "${_manifest}\n")
message(STATUS "Staged ${_copy_count} private runtime libraries under ${_output}")
